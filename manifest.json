{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "1.5.0",
  "action": {
    "default_icon": {
      "16": "icons/action16.png",
      "20": "icons/action20.png",
      "24": "icons/action24.png",
      "32": "icons/action32.png",
      "48": "icons/action48.png"
    },
    "default_popup": "src/popup.html",
    "default_title": "ChatGPT Model Usage"
  },
  "icons": {
    "16": "icons/icon16.png",
    "20": "icons/icon20.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "alarms",
    "downloads",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://status.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "exclude_matches": [
        "https://chatgpt.com/api/*",
        "https://chatgpt.com/backend-api/*",
        "https://chat.openai.com/api/*",
        "https://chat.openai.com/backend-api/*"
      ],
      "js": [
        "src/model-catalog.js",
        "src/detector.js",
        "src/exporter.js",
        "src/conversation-source.js",
        "src/dashboard.js",
        "src/content.js"
      ],
      "run_at": "document_end",
      "world": "ISOLATED"
    }
  ]
}
